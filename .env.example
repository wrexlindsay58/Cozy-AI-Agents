# Copy to .env and fill in your values
# cp .env.example .env

# --- LLM (Grok/xAI primary, Ollama open-source fallback) ---
# Provider: xai (Grok only) | ollama (local only) | auto (Grok if key set, else Ollama)
LLM_PROVIDER=xai
XAI_API_KEY=your_xai_api_key
GROK_FAST_MODEL=grok-4.20-0309-non-reasoning
GROK_PRO_MODEL=grok-4.6
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_FAST_MODEL=llama3.2
OLLAMA_PRO_MODEL=llama3.1:8b
LLM_FALLBACK_ENABLED=true

# --- Database ---
DB_PATH=assistant.db
CHROMA_DB_DIR=./chroma_db

# --- Google Drive (document storage) ---
RECEIPTS_FOLDER_ID=your_google_drive_folder_id

# --- QuickBooks Online ---
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REALM_ID=
QUICKBOOKS_REFRESH_TOKEN=
QUICKBOOKS_ENVIRONMENT=sandbox

# --- Bill.com ---
BILLCOM_DEV_KEY=
BILLCOM_ORG_ID=
BILLCOM_USERNAME=
BILLCOM_PASSWORD=
BILLCOM_ENVIRONMENT=sandbox

# --- BambooHR ---
BAMBOOHR_SUBDOMAIN=yourcompany
BAMBOOHR_API_KEY=

# --- Google Chat & Approvals ---
GOOGLE_CHAT_SPACE=spaces/AAAA...
DEFAULT_APPROVER_EMAIL=owner@company.com
APPROVAL_BASE_URL=http://localhost:3000
APPROVAL_ESCALATION_HOURS=24

# --- AR / Collections ---
COLLECTIONS_FROM_EMAIL=owner@company.com
LIEN_RIGHTS_STATE=CA

# --- Progress Billing Defaults ---
DEFAULT_DEPOSIT_PERCENT=40
DEFAULT_RETAINAGE_PERCENT=10

# --- AP Approval Thresholds ---
AP_AUTO_APPROVE_THRESHOLD=500
AP_MANAGER_THRESHOLD=5000

# --- Commission & Payroll ---
DEFAULT_SALES_REP_SPLIT=80
DEFAULT_LEAD_SETTER_SPLIT=20
COMMISSION_CLAWBACK_DAYS=90
PAYROLL_OVERTIME_THRESHOLD=40
LABOR_BURDEN_RATE=1.35

# --- Cash Flow & Profitability ---
CASH_FLOW_ALERT_THRESHOLD=25000
CASH_FLOW_STARTING_BALANCE=0
FORECAST_WEEKS=13
