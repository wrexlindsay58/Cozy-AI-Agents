# Copy to .env and fill in your values
# cp .env.example .env

# --- Gemini ---
GEMINI_API_KEY=your_gemini_api_key

# --- Database ---
DB_PATH=assistant.db
CHROMA_DB_DIR=./chroma_db

# --- Google Drive (document storage) ---
RECEIPTS_FOLDER_ID=your_google_drive_folder_id

# --- QuickBooks Online ---
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REALM_ID=
QUICKBOOKS_REFRESH_TOKEN=
QUICKBOOKS_ENVIRONMENT=sandbox

# --- Bill.com ---
BILLCOM_DEV_KEY=
BILLCOM_ORG_ID=
BILLCOM_USERNAME=
BILLCOM_PASSWORD=
BILLCOM_ENVIRONMENT=sandbox

# --- BambooHR ---
BAMBOOHR_SUBDOMAIN=yourcompany
BAMBOOHR_API_KEY=

# --- Google Chat & Approvals ---
GOOGLE_CHAT_SPACE=spaces/AAAA...
DEFAULT_APPROVER_EMAIL=owner@company.com
APPROVAL_BASE_URL=http://localhost:3000
APPROVAL_ESCALATION_HOURS=24

# --- AR / Collections ---
COLLECTIONS_FROM_EMAIL=owner@company.com
LIEN_RIGHTS_STATE=CA

# --- Progress Billing Defaults ---
DEFAULT_DEPOSIT_PERCENT=40
DEFAULT_RETAINAGE_PERCENT=10
